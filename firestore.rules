rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User role & profile metadata
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Students can only create their own account with role strictly locked to 'student'
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.uid == userId
        && request.resource.data.section in ['12SHS2510', '12SHS2509'];

      // Only admins can change roles or update user documents
      allow update, delete: if isAdmin();
    }

    // Student academic records
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();

      // Initial record creation allowed only by the student owner
      allow create: if isOwner(studentId);

      // Students may only update their own tasks, study hours, and research milestones.
      // Official grades, attendance, and recommendations can only be modified by admins.
      allow update: if isAdmin()
        || (
          isOwner(studentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['tasks', 'weeklyEngagement', 'researchMilestones'])
        );

      allow delete: if isAdmin();
    }
  }
}
