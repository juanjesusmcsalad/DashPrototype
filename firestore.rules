rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email in [
          'johannpaulreblando@gmail.com',
          'paulvincentlaguardia@gmail.com',
          'danielvn2012@gmail.com',
          'carloslouieconde@gmail.com'
        ]
      );
    }

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins can read/manage all users; students can read/update only their own non-role fields
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'student'
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Admins can read/write all student records; students can read/write only their own
    match /students/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Shared announcements & section schedules
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
